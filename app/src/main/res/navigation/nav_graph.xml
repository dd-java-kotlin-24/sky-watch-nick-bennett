  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/nav_graph"
  app:startDestination="@id/search_fragment">

  <fragment
    android:id="@+id/search_fragment"
    android:name="edu.cnm.deepdive.skywatch.app.controller.SearchFragment"
    android:label="@string/search_title"
    tools:layout="@layout/activity_main">

    <action
      android:id="@+id/open_item"
      app:destination="@id/item_fragment"/>

  </fragment>

  <!--TODO Add fragment definition for favorites.-->

  <fragment
    android:id="@+id/settings_fragment"
    android:name="edu.cnm.deepdive.skywatch.app.controller.SettingsFragment"
    android:label="@string/settings_title"/>

  <fragment
    android:id="@+id/item_fragment"
    android:name="edu.cnm.deepdive.skywatch.app.controller.ItemFragment"
    android:label="@string/item_title"
    tools:layout="@layout/fragment_item"/>

</navigation>
